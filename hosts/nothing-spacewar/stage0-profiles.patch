+fn resolve_profile_link(path: &Path) -> Option<PathBuf> {
+    let mut path = path.to_path_buf();
+
+    // `system` points to a relative generation link, which in turn points to
+    // an absolute store path. Absolute targets belong to the mounted rootfs,
+    // not to stage0's own initrd root.
+    for _ in 0..8 {
+        let target = fs::read_link(&path).ok()?;
+        path = if target.is_absolute() {
+            rootfs().join(target.strip_prefix("/").ok()?)
+        } else {
+            path.parent()?.join(target)
+        };
+
+        if !path.is_symlink() {
+            return Some(path);
+        }
+    }
